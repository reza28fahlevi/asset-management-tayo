# Konfigurasi Koneksi REST API Laravel
# Jika menjalankan Laravel secara lokal (php artisan serve): http://localhost:8000/api
# Atau menggunakan reverse proxy bawaan Vite: /api
VITE_API_BASE_URL=http://localhost:8000/api

# Aktifkan fallback data mock jika backend Laravel belum menyala / endpoint belum tersedia
VITE_ENABLE_MOCK_FALLBACK=true

# Nama Aplikasi & Versi
VITE_APP_NAME=TAYO Fleet Management
VITE_APP_ENV=production

